# ---------------------------------------------------------------------------
# the command line
# ---------------------------------------------------------------------------


def prog_name() -> str:
    """lpdf or ldiff, depending on the name that the script was invoked under."""
    called = Path(sys.argv[0]).name
    if "diff" in called:
        return "ldiff"
    return "lpdf"


LPDF_EPILOG = """examples:
  git lpdf                     PDF of the current working copy, date stamped
  git lpdf b675cdf             PDF of the main LaTeX file as of commit b675cdf
  git lpdf --main paper/ms.tex HEAD~3
  git lpdf <directory>         PDF of the copy of the repository in <directory>
"""

LDIFF_EPILOG = """examples:
  git ldiff                    compare the last commit with the working copy
  git ldiff <commit>           compare <commit> with the working copy
  git ldiff <commit1> <commit2>
  git ldiff <directory> HEAD   compare a copy of the repository with HEAD

OLD and NEW are commits, or `--` for the working copy, or a directory holding
a copy of the repository. If latexdiff struggles with your mathematics then try
the --safe and --verysafe options.
"""


def parser(mode: str) -> argparse.ArgumentParser:
    diffing = mode == "ldiff"
    argue = argparse.ArgumentParser(
        prog=f"git {mode}",
        description=textwrap.fill(
            "Produce a PDF showing the differences between two versions of a LaTeX "
            "document in a git repository, with the versions being compared printed "
            "down the margin of every page."
            if diffing
            else "Produce a PDF of a LaTeX document in a git repository, with the commit "
            "information printed down the margin of every page.",
            width=78,
        ),
        epilog=LDIFF_EPILOG if diffing else LPDF_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    add = argue.add_argument

    if diffing:
        add(
            "old",
            nargs="?",
            default="HEAD",
            metavar="OLD",
            help="the older version [HEAD]",
        )
        add(
            "new",
            nargs="?",
            default=WORKING_COPY,
            metavar="NEW",
            help="the newer version [the working copy]",
        )
    else:
        add(
            "old",
            nargs="?",
            default=WORKING_COPY,
            metavar="COMMIT",
            help="the commit to typeset [the working copy]",
        )

    add("-b", "--banner", default="", help="the banner printed in the left-hand margin")
    add("-d", "--debug", action="store_true", help="print what the script is doing")
    add("-l", "--latex", default="pdflatex", help="the latex executable [pdflatex]")
    add(
        "--latex-opt",
        default=[],
        action="append",
        metavar="OPT",
        help="an option passed to latex, repeatable; options that start with a "
        "dash need the equals form: --latex-opt=-shell-escape",
    )
    add("-m", "--main", metavar="TEXFILE", help="the main latex file")
    add("-n", "--nocleaning", action="store_true", help="keep the temporary directory")
    add(
        "-o",
        "--open",
        default=default_viewer(),
        metavar="COMMAND",
        help='the command used to open the PDF ("" to not open it)',
    )
    add(
        "--output",
        metavar="PATH",
        help="where to write the PDF [beside the latex file]",
    )
    add("-t", "--tmp", metavar="DIR", help="the temporary directory used for building")

    if diffing:
        add("-k", "--keep", action="store_true", help="keep the latexdiff LaTeX file")
        add("-s", "--safe", action="store_true", help="more robust diff of mathematics")
        add(
            "-S",
            "--verysafe",
            action="store_true",
            help="very robust diff of mathematics",
        )
        add(
            "-T",
            "--latexdiff-type",
            default="CULINECHBAR",
            metavar="TYPE",
            help="the type of diff used by latexdiff [CULINECHBAR]",
        )
        add(
            "--add-colour",
            default=DEFAULT_ADD_COLOUR,
            metavar="RGB",
            help=f'rgb colour for added text, "" to leave it blue [{DEFAULT_ADD_COLOUR}]',
        )

    add(
        "--install",
        nargs="?",
        const="",
        metavar="DIR",
        help="install the script into DIR [$HOME/bin]",
    )
    add(
        "--linkinstall",
        nargs="?",
        const="",
        metavar="DIR",
        help="link to the script from DIR [$HOME/bin]",
    )
    add("--readme", action="store_true", help="regenerate readme.rst")
    return argue


def default_viewer() -> str:
    if sys.platform == "darwin":
        return "open"
    if sys.platform.startswith("win"):
        return "start"
    return shutil.which("xdg-open") or ""


def latexdiff_options(options) -> list[str]:
    opts = [
        "--flatten",
        "--ignore-warnings",
        "--packages=amsmath,hyperref",
        "--subtype=COLOR",
    ]
    latexdiffrc = Path.home() / ".latexdiffrc"
    if latexdiffrc.is_file():
        opts += ["-c", str(latexdiffrc)]
    if options.verysafe:
        opts.append("--math-markup=off")
    elif options.safe:
        opts.append("--math-markup=whole")
    return opts


def main() -> int:
    global verbose
    mode = prog_name()
    options = parser(mode).parse_args()
    verbose = options.debug

    try:
        if options.install is not None:
            install(options.install or None, link=False)
            return 0
        if options.linkinstall is not None:
            install(options.linkinstall or None, link=True)
            return 0
        if options.readme:
            generate_readme()
            return 0

        repo = Repository()
        tex = repo.relative(options.main) if options.main else find_main_tex(repo)
        if (
            options.main
            and not (repo.root / tex).is_file()
            and options.old == WORKING_COPY
        ):
            raise GitLPDFError(f"unable to read {options.main}")
        debug(f"repository {repo.root}, main file {tex}")

        if mode == "ldiff":
            options.ldiff_options = latexdiff_options(options)

        keep_tmp = options.nocleaning or options.debug
        tmp = (
            Path(options.tmp).expanduser().resolve()
            if options.tmp
            else Path(tempfile.mkdtemp(prefix=f"git-{mode}-"))
        )
        tmp.mkdir(parents=True, exist_ok=True)
        debug(f"building in {tmp}")

        try:
            (ldiff if mode == "ldiff" else lpdf)(options, repo, tex, tmp)
        except GitLPDFError:
            # leave the build directory behind so that the log file mentioned
            # in the error message can actually be read
            keep_tmp = True
            raise
        finally:
            if keep_tmp or options.tmp:
                print(f"build files left in {tmp}")
            else:
                shutil.rmtree(tmp, ignore_errors=True)
    except GitLPDFError as error:
        print(f"git {mode}: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
