#!/usr/bin/env python3
## ======================
## git-lpdf and git-ldiff
## ======================
##
## A python script for producing PDF files from a git repository that tracks
## LaTeX documents. There are two modes:
##
## - lpdf:  produces a PDF file for a given commit in the repository
## - ldiff: uses latexdiff to produce a PDF that highlights the differences
##   between two commits
##
## In both cases the commit information is printed as a banner down the
## left-hand margin of every page of the PDF. This script is partially
## motivated by the script git-latexdiff_ and my attempts to get it to work the
## way that I wanted. The script should be used from inside a git repository.
##
## The main idea of the script is to provide an easy way to produce a PDF file
## from a git repository that is clearly annotated with the commit data. For
## example,
##
## .. code-block:: bash
##
##    > git lpdf <commit>
##
## produces a PDF file for the commit <commit> of the main LaTeX file in the
## current repository. Using latexdiff_, the command
##
## .. code-block:: bash
##
##    > git ldiff <commit>
##
## produces a PDF file that highlights the differences between the commit
## <commit> and the current working copy, and
##
## .. code-block:: bash
##
##    > git ldiff <commit1> <commit2>
##
## produces a PDF file showing the differences between two commits.
##
## Unlike the original bash implementation, LaTeX documents that are spread
## over several directories are fully supported: the directory structure of the
## repository is preserved when the files are extracted and LaTeX is run in the
## directory containing the main file, so that relative \input and
## \includegraphics paths resolve correctly.
##
## Andrew Mathas June 2014
## Claude port to python September 2026
##
## Installation
## ------------
##
## Clone the git repository, or download the script, and then type either:
##
## .. code-block:: bash
##
##   ./git-lpdf --install [directory]   # directory defaults to $HOME/bin
##
## or
##
## .. code-block:: bash
##
##   ./git-lpdf --linkinstall [directory]   # directory defaults to $HOME/bin
##
## The first version copies the script to <directory>/git-lpdf and creates a
## link from <directory>/git-ldiff to <directory>/git-lpdf. The second variation
## creates two links to the script in its current location, which is useful if
## you have cloned the git repository for git-lpdf.
##
## The script makes use of the background_ package, latexmk_ and latexdiff_.
## All three are available from ctan_ and are installed automatically with
## TeXLive.

from __future__ import annotations

import argparse
import io
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import textwrap
import time
from pathlib import Path

WORKING_COPY = "--"  # pseudo-commit meaning "the current working tree"
DEFAULT_ADD_COLOUR = "0.13,0.545,0.13"  # ForestGreen, as an rgb triple


class GitLPDFError(Exception):
    """Any error that should stop the script with a tidy message."""


# ---------------------------------------------------------------------------
# running external commands
# ---------------------------------------------------------------------------

verbose = False


def debug(*args):
    if verbose:
        print("[{}]".format(prog_name()), *args, file=sys.stderr)


def run(command, cwd=None, capture=True, check=True, env=None, stdout=None):
    r"""Run `command`, returning its stripped standard output.

    Commands are always passed as a list so that file names containing spaces,
    quotes and other awkward characters are handled correctly.
    """
    debug("running:", " ".join(str(c) for c in command))
    try:
        result = subprocess.run(
            [str(c) for c in command],
            cwd=str(cwd) if cwd else None,
            stdout=stdout
            if stdout is not None
            else (subprocess.PIPE if capture else None),
            stderr=subprocess.PIPE if capture else None,
            env=env,
        )
    except FileNotFoundError:
        raise GitLPDFError(
            f"{command[0]} not found -- is it installed and on your PATH?"
        )
    if check and result.returncode != 0:
        message = (result.stderr or b"").decode("utf-8", "replace").strip()
        raise GitLPDFError(f"{command[0]} failed: {message or result.returncode}")
    if stdout is not None or not capture:
        return result
    return result.stdout.decode("utf-8", "replace").strip()


def git(*args, cwd=None, **kwargs):
    return run(["git"] + list(args), cwd=cwd, **kwargs)


# ---------------------------------------------------------------------------
# the repository
# ---------------------------------------------------------------------------


class Repository:
    r"""The git repository that we are working in.

    Every path that the script passes around is stored *relative to the root of
    the repository*. This is the single most important invariant in the script:
    ``git ls-files`` reports paths relative to the current directory whereas
    ``git archive`` writes them relative to the repository root, and mixing the
    two is what stopped the original script from working inside subdirectories.
    """

    def __init__(self):
        try:
            root = git("rev-parse", "--show-toplevel")
        except GitLPDFError:
            raise GitLPDFError("not inside a git repository?")
        self.root = Path(root).resolve()
        # where we were invoked from, relative to the root ('' at the top)
        self.prefix = git("rev-parse", "--show-prefix")

    def tracked_files(self) -> list[Path]:
        """All files tracked by the repository, relative to its root."""
        out = git("-C", self.root, "ls-files", "-z")
        return [Path(name) for name in out.split("\0") if name]

    def is_commit(self, rev: str) -> bool:
        try:
            git(
                "-C", self.root, "rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}"
            )
            return True
        except GitLPDFError:
            return False

    def describe(self, rev: str) -> str:
        """A one line description of `rev` for use in the banner."""
        if rev == WORKING_COPY:
            return time.strftime("Latest version: %a %d %b %Y")
        return git(
            "-C",
            self.root,
            "log",
            "--pretty=format:%ad, %s, %h",
            "--date=local",
            "-n",
            "1",
            rev,
        )

    def relative(self, path) -> Path:
        """Convert `path`, as typed by the user, into a repository relative path."""
        full = Path(path).expanduser()
        if not full.is_absolute():
            full = Path.cwd() / full
        full = Path(os.path.normpath(full))
        try:
            return full.relative_to(self.root)
        except ValueError:
            raise GitLPDFError(f"{path} is not inside the repository {self.root}")


# ---------------------------------------------------------------------------
# extracting the files for a commit, a directory or the working tree
# ---------------------------------------------------------------------------


def materialise(repo: Repository, source: str, destination: Path) -> None:
    r"""Populate `destination` with the repository files for `source`.

    `source` is either ``--`` (the working tree), the name of a directory
    holding a copy of the repository, or anything that git recognises as a
    commit. In every case the directory structure of the repository is
    preserved, which is what allows \input{chapters/one} to work.
    """
    destination.mkdir(parents=True, exist_ok=True)

    if source == WORKING_COPY or Path(source).is_dir():
        top = repo.root if source == WORKING_COPY else Path(source).resolve()
        what = "working tree" if source == WORKING_COPY else f"directory {top}"
        debug(f"copying {what} into {destination}")
        copied = 0
        for name in repo.tracked_files():
            origin = top / name
            if not origin.is_file():
                debug(f"skipping {name}: not in {what}")
                continue
            target = destination / name  # <-- the relative path is kept
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(origin, target)
            copied += 1
        if copied == 0:
            raise GitLPDFError(f"no repository files found in the {what}")
    else:
        if not repo.is_commit(source):
            raise GitLPDFError(f"{source} is neither a commit nor a directory")
        debug(f"extracting commit {source} into {destination}")
        archive = run(
            ["git", "-C", repo.root, "archive", "--format=tar", source],
            stdout=subprocess.PIPE,
            capture=False,
        )
        with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as tar:
            # the data filter is only available, and only needed, from python 3.12
            if hasattr(tarfile, "data_filter"):
                tar.extractall(destination, filter="data")
            else:
                tar.extractall(destination)


# ---------------------------------------------------------------------------
# finding the main LaTeX file
# ---------------------------------------------------------------------------

DOCUMENTCLASS = re.compile(r"^[^%]*\\documentclass", re.MULTILINE)


def find_main_tex(repo: Repository) -> Path:
    r"""Guess the main LaTeX file: the tracked .tex file with a \documentclass.

    The original script used `git ls-files | grep .tex`, which matched any file
    name containing "tex" -- `context.bib` among them -- and then gave up as
    soon as the repository held more than one .tex file. Looking for
    \documentclass instead means that a document split into chapters is
    identified correctly.
    """
    candidates = []
    for name in repo.tracked_files():
        if name.suffix != ".tex":
            continue
        try:
            text = (repo.root / name).read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if DOCUMENTCLASS.search(text):
            candidates.append(name)

    if not candidates:
        raise GitLPDFError("no LaTeX file with a \\documentclass found: use --main")
    if len(candidates) == 1:
        return candidates[0]

    # several main files: prefer the ones below the directory we were called from
    here = [c for c in candidates if repo.prefix and str(c).startswith(repo.prefix)]
    if len(here) == 1:
        return here[0]

    found = "\n  ".join(str(c) for c in sorted(here or candidates))
    raise GitLPDFError(
        f"several main LaTeX files found, use --main to choose one:\n  {found}"
    )


# ---------------------------------------------------------------------------
# the banner
# ---------------------------------------------------------------------------

LATEX_ESCAPES = {
    "&": r"\&",
    "%": r"\%",
    "$": r"\$",
    "#": r"\#",
    "_": r"\_",
    "{": r"\{",
    "}": r"\}",
    "~": r"\textasciitilde{}",
    "^": r"\textasciicircum{}",
    "\\": r"\textbackslash{}",
    "<": r"\textless{}",
    ">": r"\textgreater{}",
    "|": r"\textbar{}",
}

BEGIN_DOCUMENT = re.compile(
    r"^(?P<before>[^%]*?)(?P<begin>\\begin\{document\})", re.MULTILINE
)


def latex_quote(text: str) -> str:
    """Make `text` safe to typeset. Commit messages are full of _ and & and %."""
    return "".join(LATEX_ESCAPES.get(character, character) for character in text)


def add_banner(tex_file: Path, content: str) -> None:
    r"""Print `content` down the left-hand margin of every page of `tex_file`."""
    banner = (
        r"\usepackage{background}"
        r"\backgroundsetup{position={-1,1},anchor=left,angle=90,scale=1.2,"
        r"pages=all,opacity=1,contents={" + latex_quote(content) + "}}\n"
    )

    text = tex_file.read_text(encoding="utf-8", errors="replace")
    # only the *first* \begin{document} that is not inside a comment
    match = BEGIN_DOCUMENT.search(text)
    if not match:
        raise GitLPDFError(f"no \\begin{{document}} found in {tex_file.name}")
    at = match.start("begin")
    tex_file.write_text(text[:at] + banner + text[at:], encoding="utf-8")
    debug(f"banner added to {tex_file}: {content}")


# ---------------------------------------------------------------------------
# running LaTeX
# ---------------------------------------------------------------------------

LATEXMK_ENGINE = {
    "pdflatex": "-pdf",
    "xelatex": "-pdfxe",
    "lualatex": "-pdflua",
    "latex": "-dvi",
}


def latex_environment(repo: Repository, source_directory: Path) -> dict:
    """TEXINPUTS that also looks in the real repository, for local .sty files."""
    env = dict(os.environ)
    inputs = env.get("TEXINPUTS", "")
    if not inputs:
        inputs = ".:"
    env["TEXINPUTS"] = f"{inputs}{source_directory}:{repo.root}//:"
    return env


def compile_tex(
    repo: Repository,
    tex_file: Path,
    source_directory: Path,
    engine: str,
    engine_options: list[str],
) -> Path:
    r"""Compile `tex_file` and return the PDF (or DVI) that it produces.

    LaTeX is always run *in the directory holding the file*, which is what the
    original script failed to do: it ran `pdflatex chapters/thesis` from the top
    of the tree so that \input{sections/intro} could not be found and the output
    was written to the wrong directory.
    """
    wanted = tex_file.with_suffix(".dvi" if engine == "latex" else ".pdf")
    wanted.unlink(missing_ok=True)
    env = latex_environment(repo, source_directory)

    if shutil.which("latexmk"):
        # -cd runs latex in the directory of the source file and -f carries on
        # after errors, since a document with errors often still gives a usable
        # PDF -- which is exactly what you want when reviewing a diff.
        command = ["latexmk", "-cd", "-f", "-interaction=nonstopmode"]
        command.append(LATEXMK_ENGINE.get(engine, "-pdf"))
        if engine not in LATEXMK_ENGINE:
            command.append(f"-pdflatex={engine} %O %S")
        command += engine_options + [tex_file.name]
        run(command, cwd=tex_file.parent, check=False, capture=not verbose, env=env)
    else:
        debug("latexmk not found: falling back to running latex directly")
        run_latex_by_hand(tex_file, engine, engine_options, env)

    if not wanted.is_file():
        raise GitLPDFError(
            f"unable to latex {tex_file.name}: see {tex_file.with_suffix('.log')}"
        )
    return wanted


def run_latex_by_hand(
    tex_file: Path, engine: str, engine_options: list[str], env: dict
) -> None:
    """Run latex, bibtex and latex again, for installations without latexmk."""
    directory, job = tex_file.parent, tex_file.stem
    latex = [engine, "-interaction=nonstopmode"] + engine_options + [tex_file.name]

    run(latex, cwd=directory, check=False, capture=not verbose, env=env)
    aux = directory / f"{job}.aux"
    if aux.is_file() and aux.stat().st_size:
        if r"\bibdata" in aux.read_text(encoding="utf-8", errors="replace"):
            run(
                ["bibtex", job],
                cwd=directory,
                check=False,
                capture=not verbose,
                env=env,
            )
            run(latex, cwd=directory, check=False, capture=not verbose, env=env)
        run(latex, cwd=directory, check=False, capture=not verbose, env=env)


# ---------------------------------------------------------------------------
# lpdf: a PDF of one commit
# ---------------------------------------------------------------------------


def lpdf(options, repo: Repository, tex: Path, tmp: Path) -> Path:
    materialise(repo, options.old, tmp)

    tex_file = tmp / tex
    if not tex_file.is_file():
        raise GitLPDFError(f"{tex} does not exist in {options.old}")

    add_banner(tex_file, options.banner or repo.describe(options.old))
    output = compile_tex(
        repo, tex_file, repo.root / tex.parent, options.latex, options.latex_opt
    )

    tag = "latest" if options.old == WORKING_COPY else options.old
    return deliver(options, repo, output, tex, f"{sanitise(tag)}-{tex.stem}")


# ---------------------------------------------------------------------------
# ldiff: a PDF of the differences between two commits
# ---------------------------------------------------------------------------


def ldiff(options, repo: Repository, tex: Path, tmp: Path) -> Path:
    if options.old == options.new:
        raise GitLPDFError(
            f"{options.old} and {options.new} are the same, nothing to compare"
        )

    materialise(repo, options.old, tmp / "old")
    materialise(repo, options.new, tmp / "new")

    old_tex, new_tex = tmp / "old" / tex, tmp / "new" / tex
    for name, path in (("old", old_tex), ("new", new_tex)):
        if not path.is_file():
            raise GitLPDFError(f"{tex} does not exist in the {name} version")

    # Write the diff beside the new version of the file so that \includegraphics
    # and any other relative paths still resolve. latexdiff --flatten inlines
    # \input files relative to each main file, so running it from `tmp` is fine.
    diff_tex = new_tex.with_name(f"{tex.stem}-changes.tex")
    diff = run(
        ["latexdiff"]
        + options.ldiff_options
        + [f"--type={options.latexdiff_type}", old_tex, new_tex],
        cwd=tmp,
    )
    diff_tex.write_text(
        recolour(diff.replace("\r", ""), options.add_colour), encoding="utf-8"
    )

    banner = options.banner or (
        f"LaTeX diff: {describe(repo, options.old)} -> {describe(repo, options.new)}"
    )
    add_banner(diff_tex, banner)
    output = compile_tex(
        repo, diff_tex, repo.root / tex.parent, options.latex, options.latex_opt
    )

    if options.keep:
        keep = (repo.root / tex).with_name(diff_tex.name)
        shutil.copy2(diff_tex, keep)
        print(f"LaTeX diff written to {display(keep)}")

    return deliver(options, repo, output, tex, f"{tex.stem}-changes")


def describe(repo: Repository, rev: str) -> str:
    """A short description of a version, for the ldiff banner."""
    if rev == WORKING_COPY:
        return time.strftime("working copy (%a %d %b %Y)")
    if Path(rev).is_dir():
        return str(rev)
    return git(
        "-C",
        repo.root,
        "log",
        "--pretty=format:%h (%ad)",
        "--date=short",
        "-n",
        "1",
        rev,
    )


BLUE = re.compile(r"\\color\{blue\}(?=.*%DIF PREAMBLE)")
DEFINE_COLOURS = re.compile(r"(\\definecolor\{BLUE\}[^\n]*%DIF PREAMBLE)")


def recolour(diff: str, rgb: str) -> str:
    r"""Typeset added text in green rather than blue.

    latexdiff loads the `color` package, which does not know the dvips colour
    names, so the colour has to be defined before it can be used -- the original
    script substituted \color{ForestGreen} into a document that had never heard
    of ForestGreen.
    """
    if not rgb:
        return diff
    diff = DEFINE_COLOURS.sub(
        r"\1\n\\definecolor{DIFadd}{rgb}{" + rgb + "} %DIF PREAMBLE", diff, count=1
    )
    return BLUE.sub(r"\\color{DIFadd}", diff)


# ---------------------------------------------------------------------------
# delivering the finished PDF
# ---------------------------------------------------------------------------


def sanitise(name: str) -> str:
    """Make a commit name safe to use in a file name: branches may contain /."""
    return re.sub(r"[^-\w.]", "-", name.replace("/", "-"))


def display(path: Path) -> str:
    """Show `path` relative to the current directory when that is shorter."""
    try:
        return str(path.relative_to(Path.cwd()))
    except ValueError:
        return str(path)


def deliver(options, repo: Repository, output: Path, tex: Path, stem: str) -> Path:
    """Copy the finished PDF out of the temporary directory and open it."""
    if options.output:
        destination = Path(options.output).expanduser().resolve()
        if destination.is_dir():
            destination = destination / (stem + output.suffix)
    else:
        # beside the LaTeX file it was built from, wherever that lives
        destination = (repo.root / tex).with_name(stem + output.suffix)

    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(output, destination)
    print(f"{display(destination)} created")

    if options.open:
        run([options.open, destination], check=False, capture=True)
    return destination


# ---------------------------------------------------------------------------
# installation and documentation
# ---------------------------------------------------------------------------


def install(location: str | None, link: bool) -> None:
    where = Path(location).expanduser() if location else Path.home() / "bin"
    if not where.is_dir():
        raise GitLPDFError(f"{where} is not a directory")
    me = Path(__file__).resolve()

    lpdf_link, ldiff_link = where / "git-lpdf", where / "git-ldiff"
    for target in (lpdf_link, ldiff_link):
        if target.exists() or target.is_symlink():
            target.unlink()
    if link:
        lpdf_link.symlink_to(me)
        print(f"{lpdf_link} -> {me}")
    else:
        shutil.copy2(me, lpdf_link)
        lpdf_link.chmod(0o755)
        print(f"{me} copied to {lpdf_link}")
    ldiff_link.symlink_to(lpdf_link if not link else me)
    print(f"{ldiff_link} -> {lpdf_link if not link else me}")


def generate_readme() -> None:
    """Rebuild readme.rst from the ## comments at the top of this file."""
    me = Path(__file__).resolve()
    readme = me.parent / "readme.rst"
    header = [
        re.sub(r"^##[ ]?", "", line)
        for line in me.read_text(encoding="utf-8").splitlines()
        if line.startswith("##")
    ]

    with readme.open("w", encoding="utf-8") as out:
        out.write("\n".join(header))
        for mode in ("lpdf", "ldiff"):
            title = f"Usage for the {mode} script"
            out.write(f"\n\n{title}\n{'-' * len(title)}\n\n::\n\n")
            usage = parser(mode).format_help()
            out.write("\n".join("  " + line for line in usage.splitlines()))
        out.write(LINKS.format(date=time.strftime("%d %B %Y")))
    print(f"{readme} written")


